venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.env
.DS_Store

# Raw and processed datasets must not be committed
data/raw/*
data/processed/*

# Large model/checkpoint files
models/*
*.pt
*.pth
*.ckpt
*.onnx

# Logs and experiment outputs may become large
logs/training/*
results/*

# Experiment artefacts are provenance evidence and must survive outside this machine,
# so provenance.json, final_results.json, metadata.json, metrics_history.csv,
# predictions and confusion matrices are all version-controlled. Only the checkpoints
# are too large to track. Do not re-ignore the experiments tree: git will not descend
# into an excluded directory, so a negation inside it cannot bring these files back.
experiments/**/*.pt
logs/sync_logs/

data/raw/

data/raw/
